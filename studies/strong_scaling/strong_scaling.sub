# Submit from the repository root:  condor_submit studies/strong_scaling/strong_scaling.sub
executable = /bin/bash
arguments  = studies/strong_scaling/strong_scaling.sh 16 32 64 128 256 512

log    = results/logs/strong_scaling.$(ClusterId).log
output = results/logs/strong_scaling.$(ClusterId).out
error  = results/logs/strong_scaling.$(ClusterId).err

request_cpus   = 8
request_memory = 1GB
request_disk   = 5GB

accounting_group      = ligo.dev.o4.cw.transient.viterbi
accounting_group_user = $ENV(USER)

on_exit_hold = (ExitBySignal == True) || (ExitCode != 0)
queue 1
