# Noise-only search over the O3b packs, one pack per job by default.
# Submit from the repository root:
#   condor_submit workflows/condor/noise_search.sub
#   condor_submit mode=background workflows/condor/noise_search.sub    # nsigma background
#   condor_submit tsft_list=90 workflows/condor/noise_search.sub       # other Tsft list
# Output: results/search/search_results_noise.csv (or noise_track_power.csv)

if !defined n_jobs
    n_jobs = 108
endif
if !defined mode
    mode = search
endif
if !defined packs
    packs = all
endif
if !defined tsft_list
    tsft_list = 95
endif
if !defined sft_method
    sft_method = fast
endif

# Conda environment activated by scripts/env.sh (override: conda_env=<name>).
if !defined conda_env
    conda_env = pbh-viterbi
endif

executable  = /bin/bash
arguments   = scripts/run_noise_search.sh $(n_jobs) $(Process) $(mode) $(packs)
environment = "TSFT_LIST=$(tsft_list) SFT_METHOD=$(sft_method) PBH_CONDA_ENV=$(conda_env)"

# Jobs read the repository and write results/ in place: shared filesystem only.
should_transfer_files = NO

log    = results/logs/noise_search.$(ClusterId).log
output = results/logs/noise_search.$(ClusterId).$(Process).out
error  = results/logs/noise_search.$(ClusterId).$(Process).err

# In-memory SFTs: one core, ~2 min per pack. For sft_method=makesfts use 16 cores and 8 GB.
request_cpus   = 1
request_memory = 4GB
request_disk   = 1GB

# LIGO clusters: set your accounting tag.
accounting_group      = ligo.dev.o4.cw.transient.viterbi
accounting_group_user = $ENV(USER)

on_exit_hold = (ExitBySignal == True) || (ExitCode != 0)

queue $(n_jobs)
