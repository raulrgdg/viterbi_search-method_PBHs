# Download the 108 O3b packs from GWOSC, split across $(n_jobs) jobs.
# Submit from the repository root:
#   condor_submit workflows/condor/download_o3.sub
# Defaults below can be overridden on the command line, e.g.:  condor_submit n_jobs=10 workflows/condor/download_o3.sub

if !defined n_jobs
    n_jobs = 5
endif
if !defined packs
    packs = all
endif

# Conda environment activated by scripts/env.sh (override: conda_env=<name>).
if !defined conda_env
    conda_env = pbh-viterbi
endif

executable = /bin/bash
arguments  = scripts/download_o3.sh $(n_jobs) $(Process) $(packs)
environment = "PBH_CONDA_ENV=$(conda_env)"

# Jobs read the repository and write results/ in place: shared filesystem only.
should_transfer_files = NO

log    = results/logs/download_o3.$(ClusterId).log
output = results/logs/download_o3.$(ClusterId).$(Process).out
error  = results/logs/download_o3.$(ClusterId).$(Process).err

request_cpus   = 1
request_memory = 4GB
request_disk   = 8GB

# LIGO clusters: set your accounting tag.
accounting_group      = ligo.dev.o4.cw.transient.viterbi
accounting_group_user = $ENV(USER)

on_exit_hold = (ExitBySignal == True) || (ExitCode != 0)

queue $(n_jobs)
