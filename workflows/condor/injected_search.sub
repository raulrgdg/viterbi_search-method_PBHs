# Injected search on one O3b pack: the pack's 200-signal campaign slice,
# split into $(n_jobs) jobs (10 signals, ~15-40 min each with the default Tsft list).
# Submit from the repository root:
#   condor_submit pack=1 workflows/condor/injected_search.sub
# For the whole campaign use workflows/campaign/submit_condor.sh.
# Output: results/search/search_results_injected_pack-<pack>.csv

if !defined n_jobs
    n_jobs = 20
endif
if !defined pack
    pack = 1
endif
if !defined tsft_list
    tsft_list = 95
endif
if !defined sft_method
    sft_method = fast
endif

# Output folder (PBH_VITERBI_RESULTS, relative to the repository root) and number of
# jobs actually queued (a test can queue the first few of n_jobs).
if !defined results_dir
    results_dir = results
endif
# Extra options of injected_search (e.g. "--per-tsft-output") and memory request.
if !defined search_args
    search_args =
endif
if !defined memory
    memory = 4GB
endif
if !defined n_queue
    n_queue = $(n_jobs)
endif

# Conda environment activated by scripts/env.sh (override: conda_env=<name>).
if !defined conda_env
    conda_env = pbh-viterbi
endif

executable  = /bin/bash
arguments   = scripts/run_injected_search.sh $(n_jobs) $(Process) $(pack)
environment = "TSFT_LIST=$(tsft_list) SFT_METHOD=$(sft_method) PBH_CONDA_ENV=$(conda_env) PBH_VITERBI_RESULTS=$(results_dir) SEARCH_ARGS='$(search_args)'"

# Jobs read the repository and write results/ in place: shared filesystem only.
should_transfer_files = NO

log    = $(results_dir)/logs/injected_search_pack-$(pack).$(ClusterId).log
output = $(results_dir)/logs/injected_search_pack-$(pack).$(ClusterId).$(Process).out
error  = $(results_dir)/logs/injected_search_pack-$(pack).$(ClusterId).$(Process).err

# In-memory SFTs: one core. For sft_method=makesfts use n_jobs=200, 8 cores, 12 GB.
request_cpus   = 1
# Skip the 2008 AMD Opteron nodes (no AVX, several times slower per injection).
requirements   = (TARGET.cpuinfo_model_name =?= undefined) || !regexp("Opteron", TARGET.cpuinfo_model_name)
request_memory = $(memory)
request_disk   = 1GB

accounting_group      = ligo.dev.o4.cw.transient.viterbi
accounting_group_user = $ENV(USER)

on_exit_hold = (ExitBySignal == True) || (ExitCode != 0)

queue $(n_queue)
